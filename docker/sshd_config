# Hardened non-root OpenSSH server configuration for ddg-agents-host container.
Port 2222
ListenAddress 0.0.0.0
PidFile /tmp/ddg-sshd.pid
HostKey /etc/ddg/ssh/ssh_host_ed25519_key

PermitRootLogin no
AllowUsers ddg
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /home/ddg/.ssh/authorized_keys
StrictModes yes
UsePAM no

AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PrintMotd no
PrintLastLog no
ClientAliveInterval 15
ClientAliveCountMax 4
Subsystem sftp internal-sftp
